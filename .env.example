# ========================================================
# FORZEX CONSTRUCTION - CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and insert your real secrets.
# ========================================================

PORT=3000

# Secret Google Satellite & GIS API Keys
GOOGLE_MAPS_API_KEY=your_google_maps_satellite_api_key_here
GOOGLE_SATELLITE_API_KEY=your_google_satellite_api_key_here
GOOGLE_GIS_API_KEY=your_google_gis_api_key_here

# Secret Google Gemini & AI Interior Design Models
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here
INTERIOR_AI_MODEL=gemini-2.5-flash-interior-design
PLAN_TO_VIDEO_MODEL=google-veo-architectural-3d

# Firebase Backend & Storage Credentials
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-app-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
FIREBASE_DATABASE_URL=https://your-app-default-rtdb.firebaseio.com
